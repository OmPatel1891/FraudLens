# Data - never commit the Kaggle dataset or generated stand-ins
data/
*.csv
!tests/**/*.csv
# threshold_sweep.csv is a model artifact, not data; the dashboard reads it.
!models/*.csv

# Trained artifacts are tracked, not ignored. They total ~3.6 MB, and committing
# them makes a deploy build deterministic: the platform installs dependencies and
# copies the exact model that was tested, instead of retraining on a constrained
# free builder. The commit hash therefore identifies the model version.
# Retrain with `python scripts/train.py`, then commit the changed artifacts.
mlruns/
mlartifacts/

# Generated outputs
plots/
reports/
logs/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Notebooks
.ipynb_checkpoints/

# Credentials - kaggle.json holds a live API token
kaggle.json
.env
*.pem

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
